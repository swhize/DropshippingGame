/* Stadtblatt (.sb) – Zeitung im Comic-Look: Papier, schwarze Ränder, rote Akzente */
.sb { background-color: #F4EFE1; padding-bottom: 16px; }
.sb Label { color: #1B1B1B; font-size: 14px; }
.sb .sb-top { padding: 6px 16px; border-bottom-width: 2px; border-color: #1B1B1B; }
.sb .sb-small { font-size: 12px; color: #5A554A; white-space: normal; }
.sb .sb-muted { color: #6B6558; margin: 10px 16px; white-space: normal; }
.sb .sb-mast { align-items: center; padding: 10px 0 6px 0; border-bottom-width: 5px; border-color: #1B1B1B; margin: 0 16px; }
.sb .sb-title { font-size: 58px; color: #1B1B1B; -unity-text-align: middle-center; letter-spacing: 2px; }
.sb .sb-motto { font-size: 13px; color: #B3261E; -unity-font-style: italic; }
.sb .sb-nav { padding: 6px 16px; border-bottom-width: 2px; border-color: #1B1B1B; margin: 0 16px; }
.sb .sb-nav-btn { background-color: rgba(0,0,0,0); padding: 4px 10px; border-width: 2px; border-color: rgba(0,0,0,0); }
.sb .sb-nav-btn.on { border-color: #1B1B1B; background-color: #FFFFFF; }
.sb .sb-nav-btn:hover { background-color: #FFE9A8; }
.sb .sb-cols { padding: 0 16px; margin-top: 12px; }
.sb .sb-box { background-color: #FFFDF6; border-width: 2px 5px 5px 2px; border-color: #1B1B1B; border-radius: 6px; padding: 12px; margin-top: 10px; }
.sb .sb-cols .sb-box { margin-top: 0; }
.sb > .sb-box { margin: 12px 16px 0 16px; }
.sb .sb-lead { background-color: #FFFFFF; }
.sb .sb-h1 { font-size: 32px; white-space: normal; color: #1B1B1B; }
.sb .sb-h2 { font-size: 16px; white-space: normal; }
.sb .sb-text { white-space: normal; }
.sb .sb-store { font-size: 26px; }
.sb .sb-mm .sb-store { color: #D0141E; }
.sb .sb-fn .sb-store { color: #1F7A3D; }
.sb .sb-mm { border-color: #D0141E; }
.sb .sb-fn { border-color: #1F7A3D; }
.sb .sb-price { font-size: 22px; color: #D0141E; }
.sb .sb-stamp { background-color: #D0141E; color: #FFFFFF; font-size: 12px; padding: 2px 6px; border-radius: 4px; align-self: flex-start; rotate: -3deg; }
.sb .sb-good { color: #1F7A3D; font-size: 12px; }
.sb .sb-line { padding: 8px 2px; border-bottom-width: 2px; border-color: #E4DECC; align-items: center; }
.sb .sb-btn { background-color: #FFD23F; border-width: 2px; border-color: #1B1B1B; align-self: flex-start; margin-top: 4px; }
.sb .sb-ad { background-color: #FFF6CC; }
.sb .sb-grid { padding: 0 16px; }
.sb .sb-foot { font-size: 11px; color: #7A7466; margin: 18px 16px 0 16px; -unity-text-align: middle-center; }
